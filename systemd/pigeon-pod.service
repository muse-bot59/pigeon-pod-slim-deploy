[Unit]
Description=PigeonPod (standalone jar, extracted from Docker image)
After=network-online.target warp-svc.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/root/pigeon-pod
ExecStart=/usr/bin/java -Dfile.encoding=UTF-8 -jar /root/pigeon-pod/app.jar
Restart=always
RestartSec=10
Environment="SERVER_PORT=8081"
Environment="SPRING_DATASOURCE_URL=jdbc:sqlite:/root/pigeon-pod/data/pigeon-pod.db?journal_mode=WAL&synchronous=NORMAL&cache_size=10000&temp_store=memory&busy_timeout=3000"
Environment="PIGEON_FFMPEG_LOCATION=/usr/bin/ffmpeg"
Environment="PIGEON_LOG_FILE=/root/pigeon-pod/data/logs/pigeon-pod.log"
Environment="PIGEON_YT_DLP_MANAGED_ROOT=/root/pigeon-pod/data/tools/yt-dlp"
Environment="PIGEON_AUDIO_FILE_PATH=/root/pigeon-pod/data/audio/"
Environment="PIGEON_VIDEO_FILE_PATH=/root/pigeon-pod/data/video/"
Environment="PIGEON_COVER_FILE_PATH=/root/pigeon-pod/data/cover/"
Environment="PIGEON_SSL_FILE_PATH=/root/pigeon-pod/data/ssl/"
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
